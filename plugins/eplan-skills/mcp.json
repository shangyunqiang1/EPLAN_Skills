{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "eplan": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/run_mcp.py"
      ]
    },
    "eplan-rag": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/documentation.py",
        "--server",
        "eplan-rag"
      ]
    },
    "eplan-wiki-2027": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/documentation.py",
        "--server",
        "eplan-wiki-2027"
      ]
    },
    "eecpro-rag": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/documentation.py",
        "--server",
        "eecpro-rag"
      ]
    }
  }
}
